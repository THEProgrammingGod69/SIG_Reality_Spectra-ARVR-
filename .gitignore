# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# testing
/coverage
/playwright-report
/test-results
/blob-report
/.playwright

# env files — real secrets are never committed.
# .env.example IS committed: it is the contract for what every environment needs.
.env
.env.*
!.env.example

# netlify
.netlify

# reference media (Stage 2/3 inputs) — heavy binaries stay out of git history.
# NOTES.md and still images are committed so the intent is reviewable.
/references/**/*.mp4
/references/**/*.mov
/references/**/*.webm
/references/**/*.gif
/references/**/*.zip

# misc
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local data mode (D-031): records and uploads on this computer only
.data/

# This project uses pnpm (CLAUDE.md §2): never commit another package manager's lockfile.
package-lock.json
yarn.lock
