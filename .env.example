# =============================================================================
# SIG Reality Spectra — environment contract
# =============================================================================
# Copy this file to `.env.local` and fill in the values for the stage you are
# working on. Every variable is validated by `src/lib/env.ts` at startup.
#
#   cp .env.example .env.local
#
# Variables are grouped by the stage that first needs them. A variable you have
# not reached yet can stay blank — the app only fails when a feature that needs
# it actually runs.
#
# NEVER commit `.env.local`. It is gitignored. Only this example file is
# tracked, and it must never contain a real secret.
# =============================================================================


# -----------------------------------------------------------------------------
# Stage 1 — foundation
# -----------------------------------------------------------------------------

# Canonical origin of the site, with no trailing slash.
# Local: http://localhost:3000   Production: https://<club-domain>
# Used for absolute URLs, OpenGraph tags, sitemap.xml and canonical links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# Stage 5 — data layer (Upstash Redis + Cloudflare R2)
# -----------------------------------------------------------------------------
# Step-by-step account setup: docs/SETUP_STORAGE.md

# Where data lives:
#   upstash -> Upstash Redis (records) + Cloudflare R2 (files): the real thing
#   local   -> a JSON file and a folder in .data/ on this computer, for working
#              before the accounts exist (D-031). Netlify refuses to build with it.
DATA_BACKEND="upstash"

# Upstash Redis, created on upstash.com with the club account.
# Database page → REST API section.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Which copy of the club's data this environment uses. Prefixes every Redis key
# and every R2 file, so environments can share one database and one bucket.
#   local dev  -> dev
#   previews   -> preview   (set per deploy context on Netlify)
#   production -> prod      (Netlify refuses to deploy production with anything else)
DATA_NAMESPACE="dev"

# Cloudflare R2: event posters and photos, gallery and team photos, the
# recruitment roles PDF and nightly backups.
# Account id: R2 overview page. Keys: an R2 API token with "Object Read &
# Write" on this bucket only.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# The bucket's public address, no trailing slash: its r2.dev URL or a custom
# domain, e.g. https://media.<club-domain>
R2_PUBLIC_BASE_URL=""


# -----------------------------------------------------------------------------
# Stage 6 — admin authentication (Auth.js: email + password, Google)
# -----------------------------------------------------------------------------

# Step-by-step: docs/SETUP_AUTH.md

# Session signing secret. Generate a fresh one per environment:
#   openssl rand -base64 32
# Required for any sign-in, including the development sign-in.
AUTH_SECRET=""

# Google Cloud OAuth 2.0 client, created under the CLUB Google account.
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<club-domain>/api/auth/callback/google
# Leave blank until it exists: `pnpm dev` offers the development sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated allowlist of the emails permitted to reach /admin (their
# Google accounts, or the emails they type with ADMIN_PASSWORD below).
# This is the entire access-control list — there is no user table.
# Handover each year is done by editing this one variable.
#   ADMIN_EMAILS="secretary1@vit.edu,secretary2@vit.edu,webmaster@vit.edu"
ADMIN_EMAILS=""

# The admin password: with it, any address in ADMIN_EMAILS can sign in with
# email + password at /admin/login (Google is then optional). Choose a long
# passphrase (12+ characters; the dashboard warns about a short or common one),
# set it only in .env.local and in Netlify, and never commit it. Changing it
# signs every password session out. Leave blank to turn the password sign-in off.
ADMIN_PASSWORD=""

# "true" enables the development sign-in (no password, allowlisted emails only)
# in a production build — used by the end-to-end tests. `pnpm dev` has it on
# already. Netlify deploys refuse to build with it set.
# AUTH_DEV_SIGN_IN="true"


# -----------------------------------------------------------------------------
# Stage 8 — sponsorship requests and spam protection
# -----------------------------------------------------------------------------

# Sponsorship requests are stored and read in /admin/sponsorships — there is no
# email integration, so no mail provider account or verified domain is needed.

# Cloudflare Turnstile keys for public form protection (D-032).
# The site key is public and shipped to the browser; the secret key is not.
# Leave both blank locally: the check is off off-Netlify. A Netlify deploy
# without both keys hides the form and lists the club's channels instead.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""


# -----------------------------------------------------------------------------
# Stage 9 — analytics
# -----------------------------------------------------------------------------

# Cloudflare Web Analytics (D-033): cookieless page-view counts, so no consent
# banner is needed. Cloudflare dashboard (club account) → Analytics & Logs →
# Web Analytics → Add a site → "Manual setup" → copy the token from the snippet.
# Public by design. Leave blank and no analytics script loads; it never loads
# under `pnpm dev` either.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=""


# -----------------------------------------------------------------------------
# Stage 10 — the nightly job (D-034)
# -----------------------------------------------------------------------------

# Secret the Netlify scheduled function sends as "Authorization: Bearer <secret>"
# when it calls the nightly job (backup of every record + sweep of uploads never
# attached to a record). Generate with: openssl rand -base64 32
CRON_SECRET=""


# -----------------------------------------------------------------------------
# Escape hatch
# -----------------------------------------------------------------------------

# Set to "1" to skip environment validation entirely. Intended for container
# image builds that have no runtime secrets available. Never set in production.
# SKIP_ENV_VALIDATION="1"
