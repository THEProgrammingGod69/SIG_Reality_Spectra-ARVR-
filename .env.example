# =============================================================================
# SIG Reality Spectra — environment contract
# =============================================================================
# Copy this file to `.env.local` and fill in the values for the stage you are
# working on. Every variable is validated by `src/lib/env.ts` at startup.
#
#   cp .env.example .env.local
#
# Variables are grouped by the stage that first needs them. A variable you have
# not reached yet can stay blank — the app only fails when a feature that needs
# it actually runs.
#
# NEVER commit `.env.local`. It is gitignored. Only this example file is
# tracked, and it must never contain a real secret.
# =============================================================================


# -----------------------------------------------------------------------------
# Stage 1 — foundation
# -----------------------------------------------------------------------------

# Canonical origin of the site, with no trailing slash.
# Local: http://localhost:3000   Production: https://<club-domain>
# Used for absolute URLs, OpenGraph tags, sitemap.xml and canonical links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# Stage 5 — data layer (Upstash Redis + Vercel Blob)
# -----------------------------------------------------------------------------

# Upstash Redis, added through the Vercel Marketplace on the club's Vercel
# project. After linking, pull the values with: vercel env pull .env.local
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Namespace prefixed to every Redis key.
# Production and Preview MUST use different prefixes so preview deployments can
# never read or overwrite live club data.
#   local dev  -> sig:dev
#   preview    -> sig:preview
#   production -> sig:prod
REDIS_KEY_PREFIX="sig:dev"

# Vercel Blob read/write token. Stores event posters and photos, team photos,
# the recruitment roles PDF and nightly backups, and signs the short-lived
# tokens that let the admin panel upload files straight from the browser.
# Create the Blob store on the club's Vercel project, then copy the token.
BLOB_READ_WRITE_TOKEN=""


# -----------------------------------------------------------------------------
# Stage 6 — admin authentication (Auth.js + Google)
# -----------------------------------------------------------------------------

# Session signing secret. Generate a fresh one per environment:
#   openssl rand -base64 32
AUTH_SECRET=""

# Google Cloud OAuth 2.0 client, created under the CLUB Google account.
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<club-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated allowlist of Google accounts permitted to reach /admin.
# This is the entire access-control list — there is no user table.
# Handover each year is done by editing this one variable.
#   ADMIN_EMAILS="secretary1@vit.edu,secretary2@vit.edu,webmaster@vit.edu"
ADMIN_EMAILS=""


# -----------------------------------------------------------------------------
# Stage 8 — sponsorship requests, email and spam protection
# -----------------------------------------------------------------------------

# Resend API key, used to alert the club inbox about new sponsorship requests.
RESEND_API_KEY=""

# Club inbox that is alerted about each new sponsorship/collaboration request.
# Requests are always stored for /admin/sponsorships even if email fails.
SPONSORSHIP_NOTIFY_EMAIL=""

# Sender address for outgoing mail. Must be on a Resend-verified domain in
# production, otherwise delivery will be rejected.
EMAIL_FROM=""

# Cloudflare Turnstile keys for public form protection.
# The site key is public and shipped to the browser; the secret key is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""


# -----------------------------------------------------------------------------
# Stage 10 — scheduled jobs
# -----------------------------------------------------------------------------

# Secret that Vercel Cron sends as "Authorization: Bearer <secret>" when it calls
# the nightly job (Redis backup to Blob + sweep of uploads never attached to a
# record). Generate with: openssl rand -base64 32
CRON_SECRET=""


# -----------------------------------------------------------------------------
# Escape hatch
# -----------------------------------------------------------------------------

# Set to "1" to skip environment validation entirely. Intended for container
# image builds that have no runtime secrets available. Never set in production.
# SKIP_ENV_VALIDATION="1"
